# =====================================================================
#  Sitio publico ESCORT SECURITY SERVICES (Angular compilado)
#
#  Este archivo se copia junto con el resultado de `npm run build`.
#  Su trabajo es devolver index.html en cualquier ruta para que el
#  enrutador de Angular funcione al recargar o entrar por URL directa.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- La API ---------------------------------------------------------
    # El backend se despliega en backend/, con su controlador frontal en
    # backend/public/index.php. Nada de /api existe fisicamente: estas reglas
    # traducen /api/* a esa carpeta antes de que actue el enrutador de Angular.

    # Authorization se pierde en CGI/FastCGI; se reinyecta como variable.
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^api/ - [E=HTTP_AUTHORIZATION:%1]

    # Las imagenes subidas desde el panel se sirven desde su carpeta real.
    RewriteCond %{DOCUMENT_ROOT}/backend/public/uploads/$1 -f
    RewriteRule ^api/uploads/(.*)$ backend/public/uploads/$1 [L]

    # Una subida que ya no existe devuelve 404, no el index de Angular: si no,
    # un <img> roto recibiria la app entera con estado 200.
    RewriteRule ^api/uploads/ - [R=404,L]

    # El resto entra por el controlador frontal. La ruta viaja en ?_ruta=
    # porque index.php la deduce de SCRIPT_NAME, y ahi veria /backend/public
    # en lugar de /api. QSA conserva los parametros originales de la URL.
    RewriteRule ^api/?(.*)$ backend/public/index.php?_ruta=/$1 [QSA,L]

    # Los archivos y carpetas que existen se sirven tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demas lo resuelve Angular.
    RewriteRule ^ index.html [L]
</IfModule>

# --- Cabeceras de seguridad -------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Los archivos con hash en el nombre se pueden cachear indefinidamente.
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # El index nunca se cachea: es lo que apunta a los archivos nuevos.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compresion --------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

Options -Indexes
ErrorDocument 404 /index.html

# =====================================================================
#  Sitio publico ESCORT SECURITY SERVICES (Angular compilado)
#
#  Este archivo se copia junto con el resultado de `npm run build`.
#  Su trabajo es devolver index.html en cualquier ruta para que el
#  enrutador de Angular funcione al recargar o entrar por URL directa.
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # La API vive en /api: no la toca el enrutador del front.
    RewriteRule ^api/ - [L]

    # Los archivos y carpetas que existen se sirven tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demas lo resuelve Angular.
    RewriteRule ^ index.html [L]
</IfModule>

# --- Cabeceras de seguridad -------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Los archivos con hash en el nombre se pueden cachear indefinidamente.
    <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # El index nunca se cachea: es lo que apunta a los archivos nuevos.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Compresion --------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

Options -Indexes
ErrorDocument 404 /index.html
